{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bma-cad:design-brief:v1",
  "title": "Engineer-owned brief for a support-bracket design study",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "brief", "baseline", "requirements", "candidate_count"],
  "properties": {
    "schema_version": {"const": "bma-cad/design-brief/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "brief": {"type": "string", "minLength": 1, "maxLength": 8000},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stock_thickness_mm", "pocket_depth_mm"],
      "properties": {
        "stock_thickness_mm": {"type": "number", "minimum": 10, "maximum": 20},
        "pocket_depth_mm": {"type": "number", "minimum": 1, "maximum": 18}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_stock_mm", "minimum_floor_mm", "minimum_volume_reduction_percent"],
      "properties": {
        "available_stock_mm": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"type": "number", "minimum": 10, "maximum": 20}
        },
        "minimum_floor_mm": {"type": "number", "minimum": 2, "maximum": 19},
        "minimum_volume_reduction_percent": {"type": "number", "minimum": 0, "maximum": 90}
      }
    },
    "candidate_count": {"type": "integer", "minimum": 0, "maximum": 4}
  }
}
