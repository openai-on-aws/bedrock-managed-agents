        <mxCell id="legend-outer" value="" style="rounded=0;html=1;strokeWidth=1.5;strokeColor=#B7C7DA;fillColor=light-dark(#EDF3FF,#20394B);fillStyle=auto;container=0;pointerEvents=0;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2230" y="30" width="530" height="1490" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="Read the architecture" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2260" y="58" width="470" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-intro" value="1–8  Build, inspect and resume" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2260" y="106" width="470" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-1" value="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="151" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-title" value="Start or resume the study" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="150" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-1-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The local CLI submits a frozen JSON brief and job allocation. Later feedback uses the same BMA session.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="181" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-2" value="2" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="246" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-title" value="Plan with a Bedrock model" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="245" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-2-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;BMA's managed Codex harness chooses candidate dimensions, invokes tools and compares measured results.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="276" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-3" value="3" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="341" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-title" value="Reach the CAD tools securely" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="340" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-3-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The BMA session role invokes AgentCore Gateway. Its MCP tools are create_support and get_result.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="371" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-4" value="4" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="436" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-title" value="Dispatch a bounded native job" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="435" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-4-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Lambda validates dimensions, reserves the S3 job ID and submits a fixed SSM command to this worker only.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="466" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-5" value="5" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="531" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-title" value="Build, freeze and verify" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="530" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-5-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;One EC2 host runs a → b → c. Separate author and checker users; 11 checks on the frozen native files.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="561" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-6" value="6" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="626" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-title" value="Publish evidence and verdict" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="625" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-6-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The supervisor publishes CAD files and check reports with SHA-256 hashes and recorded S3 versions.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="656" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-7" value="7" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="721" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-7-title" value="Read evidence and revise" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="720" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-7-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;BMA retrieves receipts through Lambda and S3. An existing checked candidate can satisfy a revised brief.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="751" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-8" value="8" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="816" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-8-title" value="Collect; pause for engineer review" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="815" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-8-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The client verifies files and brief compliance. Reports remain awaiting_review; new feedback resumes the session.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="846" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-9" value="9" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="966" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-9-title" value="Optional execution workspace" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="965" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-9-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;An existing BMA exec-server Runtime adds scripts, skills and persistent files. This path has not been live-tested.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="996" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-badge-10" value="10" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;glass=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2255" y="1081" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-10-title" value="Independent scheduled EC2 stop" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="1080" width="425" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-step-10-detail" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A one-time UTC deadline calls StopInstances. It can interrupt a job; the BMA session and stored evidence remain.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=0;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2310" y="1111" width="425" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-operations" value="Separate capabilities and lifecycle control" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=light-dark(#232F3E,#F4F7FA);spacing=0;overflow=hidden;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2258" y="929" width="470" height="26" as="geometry" />
