        <mxCell id="step-9" value="9" style="rounded=1;arcSize=30;html=1;align=center;verticalAlign=middle;fillColor=#007CBD;strokeColor=default;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;fontStyle=1;shadow=1;glass=0;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1">
